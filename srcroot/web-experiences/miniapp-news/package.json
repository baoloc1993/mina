    "dev:mock": "npm run build && node ../../mobile-experiences/shell/packages/miniapp-sdk/mock/run.mjs $(pwd)/dist"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "ajv": "^8.20.0",
    "happy-dom": "^20.14.6",
    "jsdom": "^26.1.0",
    "typescript": "~6.0.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
