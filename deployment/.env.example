# Chỉ TÊN biến + mô tả. Giá trị thật ở deployment/local/.env (không commit).
SUPABASE_URL=             # URL API Supabase; emulator Android gọi máy host qua http://10.0.2.2:54321
SUPABASE_ANON_KEY=        # key public cho client (shell)
SUPABASE_SERVICE_ROLE_KEY= # chỉ script seed/publish trên máy dev; không vào bundle shell
SUPABASE_JWT_SECRET=      # PowerSync xác thực JWT phiên
APP_TOKEN_SECRET=         # Edge Function issue-app-token ký app token HS256
POWERSYNC_URL=            # endpoint PowerSync cho shell (emulator: http://10.0.2.2:8080)
APP_TOKEN_TTL_SECONDS=    # hạn app token, mặc định 900
GOOGLE_OAUTH_CLIENT_ID=   # Google Sign-In phía server (vòng 2) — để trống ở local, Makefile đặt giá trị giả
GOOGLE_OAUTH_CLIENT_SECRET= # nt
APPLE_CLIENT_ID=          # Apple Sign-In phía server (vòng 2) — chưa chi Apple Developer, để trống ở local
APPLE_CLIENT_SECRET=      # nt
SIGNING_KEY_PATH=         # file khoá ký Ed25519 (PEM) NGOÀI repo; mặc định deployment/local/keys/signing-local-1.pem (make dev sinh)
SIGNING_KEY_ID=           # key_id ghi vào app_versions/signing_keys; mặc định local-1
DATABASE_URL=             # CLI registry áp migration server; mặc định postgresql://postgres:postgres@127.0.0.1:54322/postgres
PUBLIC_API_URL=           # (tuỳ chọn) địa chỉ API công khai để catalog ký URL tải; mặc định suy từ Host người gọi
ENTITLEMENT_GRACE_DAYS=   # ân hạn chỉ đọc (ngày), mặc định 7 — catalog và upload cùng đọc (vòng 3)
FILE_CACHE_MAX_MB=        # ngưỡng dọn LRU cache file trên máy, mặc định 200 (vòng 3, file chưa upload không bao giờ bị dọn)
# ---- vòng 7: production (giá trị thật ở deployment/prod/.env — không commit; xem deployment/prod/README.md) ----
SUPABASE_PROJECT_REF=     # 20 ký tự trong URL project Supabase Cloud (prod)
SUPABASE_ACCESS_TOKEN=    # token cá nhân của người vận hành (supabase.com/dashboard/account/tokens) — link, functions deploy, Management API
SUPABASE_DB_PASSWORD=     # mật khẩu database của project (CLI `link` / `db push` đọc từ môi trường)
# (prod dùng lại SUPABASE_URL=https://<ref>.supabase.co · SUPABASE_ANON_KEY · SUPABASE_SERVICE_ROLE_KEY · APP_TOKEN_SECRET · DATABASE_URL · POWERSYNC_URL như trên)
# DATABASE_URL prod = chuỗi "Session pooler" (cổng 5432) ở Dashboard → Connect; kết nối trực tiếp chỉ IPv6.
POWERSYNC_INSTANCE_ID=    # PowerSync Cloud: id instance (đẩy sync rules)
POWERSYNC_ADMIN_TOKEN=    # PowerSync Cloud: token quản trị (chỉ máy người vận hành)
ANDROID_KEYSTORE_PATH=    # keystore release (.jks) NGOÀI repo — sao lưu 2 nơi; mất = không cài đè được APK đã phát
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
ANDROID_CERT_SHA256=    # dấu vân tay chứng chỉ ký APK production — release-android in ra ở lần build đầu; từ đó build với keystore khác sẽ bị TỪ CHỐI
ANDROID_VERSION_CODE=     # (tuỳ chọn) mặc định = số phút từ 2026-01-01, luôn tăng
GIT_SHA=                  # deploy.py tự đặt cho Edge Functions (hiện ở /health)
RATE_LIMIT_UPLOAD_PER_MIN= # trần theo user mỗi phút, mặc định 120 (upload)
RATE_LIMIT_TOKEN_PER_MIN=  # mặc định 30 (issue-app-token)
RATE_LIMIT_CATALOG_PER_MIN= # mặc định 30 (catalog)
EXPO_PUBLIC_OAUTH_PROVIDERS= # nút đăng nhập Google/Apple trong shell: danh sách "google,apple"; MẶC ĐỊNH RỖNG = chỉ Email OTP (make dev đặt google,apple; bản release production vòng 7 để trống)
