# Chỉ TÊN biến + mô tả. Giá trị thật ở deployment/local/.env (không commit).
SUPABASE_URL=             # URL API Supabase; emulator Android gọi máy host qua http://10.0.2.2:54321
SUPABASE_ANON_KEY=        # key public cho client (shell)
SUPABASE_SERVICE_ROLE_KEY= # chỉ script seed/publish trên máy dev; không vào bundle shell
SUPABASE_JWT_SECRET=      # PowerSync xác thực JWT phiên
APP_TOKEN_SECRET=         # Edge Function issue-app-token ký app token HS256
POWERSYNC_URL=            # endpoint PowerSync cho shell (emulator: http://10.0.2.2:8080)
APP_TOKEN_TTL_SECONDS=    # hạn app token, mặc định 900
